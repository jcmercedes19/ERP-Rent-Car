rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permitir acceso a archivos públicos (ej. logos de empresas)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Archivos por empresa (aislados)
    match /companies/{companyId}/{allPaths=**} {
      // Idealmente aquí se verificaría request.auth.token.companyId, pero como MVP:
      allow read, write: if request.auth != null;
    }
    
    // Fallback general temporal para desarrollo
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
